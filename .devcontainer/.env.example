# Copy this file to .devcontainer/.env and fill in the real value.
# Do not commit .devcontainer/.env.

# Required. ACF PRO license key used for Composer install and runtime activation.
ACF_PRO_LICENSE=

# Optional. ACF Composer uses this as the activation URL. localhost:8080 is a dev URL.
ACF_PRO_SITE_URL=http://localhost:8080

# Optional. Use an exact version if the project needs a pinned ACF PRO release.
ACF_PRO_VERSION=^6.0
